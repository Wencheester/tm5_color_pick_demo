<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tm5-700">
  <xacro:arg name="ns" default="" />
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="color" default="emeraldgreen" />
  <xacro:arg name="dae_parse_gzskin" default="false" />
  <xacro:arg name="initial_positions_file" default="$(find tm_gazebo)/config/initial_positions.yaml"/>

  <xacro:include filename="$(find tm_gazebo)/xacro/macro.materials.xacro" />
  <xacro:include filename="$(find tm_gazebo)/xacro/macro.inertial.xacro" />
  <xacro:include filename="$(find tm_gazebo)/xacro/tm.ros2_control.xacro"/>
  <xacro:include filename="$(find tm_gazebo)/xacro/macro.tm5-700-nominal.urdf.xacro" />
  <xacro:include filename="$(find tm_gazebo)/xacro/tm.gazebo.xacro"/>

  <xacro:tm_ros2_control
    name="CobotSystem" prefix="$(arg prefix)" initial_positions_file="$(arg initial_positions_file)"/>

  <link name="world" />
  <joint name="world_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <xacro:tm5-700
    ns="$(arg ns)"
    prefix="$(arg prefix)"
    color="$(arg color)"
    format="obj"
    dae_parse_gzskin="$(arg dae_parse_gzskin)" />

  <link name="tool_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.035 0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.035 0.03"/>
      </geometry>
    </collision>
    <xacro:cuboid_inertial width="0.045" height="0.035" depth="0.03" mass="0.05">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:cuboid_inertial>
  </link>

  <joint name="tool0-tool_camera" type="fixed">
    <parent link="tool0"/>
    <child link="tool_camera_link"/>
    <origin xyz="0.045 0 0.055" rpy="0 0 0"/>
  </joint>

  <link name="tool_camera_optical_frame"/>

  <joint name="tool_camera-optical" type="fixed">
    <parent link="tool_camera_link"/>
    <child link="tool_camera_optical_frame"/>
    <!-- Match the Gazebo camera sensor pose below, converted to ROS optical frame convention. -->
    <origin xyz="0.035 0 0" rpy="-1.570796 0 3.141593"/>
  </joint>

  <link name="suction_cup_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.025"/>
      </geometry>
      <material name="black"/>
    </visual>
    <xacro:cylinder_inertial_x radius="0.018" length="0.025" mass="0.03">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:cylinder_inertial_x>
  </link>

  <joint name="tool0-suction_cup" type="fixed">
    <parent link="tool0"/>
    <child link="suction_cup_link"/>
    <origin xyz="0.03 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="tool_camera_link">
    <sensor name="tool_rgb_camera" type="camera">
      <!-- Gazebo cameras look along sensor +X. Point +X toward tool -Y so ready2 looks down at the table. -->
      <pose>0.035 0 0 0 0 -1.570796</pose>
      <topic>/tool_camera/image</topic>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>2.0</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <xacro:tm_gazebo ns="$(arg ns)" prefix="$(arg prefix)" />
</robot>
