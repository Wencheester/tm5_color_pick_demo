        <visual name="grid_line_vertical_left_center">
          <pose>-0.0665 0 0.013 0 0 0</pose>
          <geometry>
            <box>
              <size>0.006 0.43 0.003</size>
            </box>
          </geometry>
          <material>
            <ambient>0.03 0.03 0.03 1</ambient>
            <diffuse>0.03 0.03 0.03 1</diffuse>
          </material>
        </visual>
        <visual name="grid_line_vertical_center_right">
          <pose>0.0665 0 0.013 0 0 0</pose>
