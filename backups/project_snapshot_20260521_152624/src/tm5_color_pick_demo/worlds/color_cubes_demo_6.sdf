            <diffuse>0.70 0.76 0.92 1</diffuse>
          </material>
        </visual>
        <visual name="slot_right_bottom_sort_red">
          <pose>0.133 -0.133 0.0115 0 0 0</pose>
          <geometry>
            <box>
              <size>0.118 0.118 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.92 0.70 0.70 1</ambient>
            <diffuse>0.92 0.70 0.70 1</diffuse>
          </material>
