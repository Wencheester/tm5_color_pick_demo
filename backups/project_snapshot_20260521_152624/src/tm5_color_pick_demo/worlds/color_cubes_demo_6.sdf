      </link>
    </model>

    <model name="red_cube">
      <pose>0.367 0.133 0.235 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
